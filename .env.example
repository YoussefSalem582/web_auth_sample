# Copy to .env.local and fill in. Never commit .env.local.

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Public base URL. Locally use the ngrok URL while testing webhooks, otherwise
# Paymob cannot reach your machine. On Vercel set it to your deployed domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Supabase — Dashboard > Project Settings > API
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Paymob — Dashboard (accept.paymob.com) > Settings
# ---------------------------------------------------------------------------
# Settings > Account Info > API Keys ("Secret Key", starts with egy_sk_...)
# SERVER ONLY. Anyone with this can charge your account.
PAYMOB_SECRET_KEY=

# Settings > Account Info > API Keys ("Public Key", starts with egy_pk_...)
# Safe to expose — it ends up in the Unified Checkout URL.
PAYMOB_PUBLIC_KEY=

# Developers > Payment Integrations > the "Online Card" / "Mobile Wallet" rows.
# Comma-separated integration IDs, integers only. One or many.
PAYMOB_INTEGRATION_IDS=1234567,7654321

# Settings > Account Info > HMAC. Used to verify the webhook signature.
PAYMOB_HMAC_SECRET=
